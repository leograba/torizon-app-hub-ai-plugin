{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$title": "Torizon App Hub Bundle (bundle.yaml)",
  "type": "object",
  "required": ["schemaVersion", "compatibility", "bundle"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Version of the bundle.yaml schema format.",
      "pattern": "^3\\.\\d+\\.\\d+$"
    },
    "compatibility": {
      "type": "object",
      "description": "Compatibility constraints for hardware and optional OS versions.",
      "additionalProperties": false,
      "required": ["hardware"],
      "properties": {
        "hardware": {
          "type": "object",
          "description": "Hardware compatibility declarations.",
          "additionalProperties": false,
          "required": ["machineIds"],
          "properties": {
            "machineIds": {
              "type": "array",
              "minItems": 1,
              "description": "Supported machine IDs for this bundle.",
              "items": { "type": "string", "description": "One supported machine identifier." }
            }
          }
        },
        "torizonOS": {
          "type": "object",
          "description": "Optional Torizon OS compatibility constraints.",
          "additionalProperties": false,
          "properties": {
            "minVersion": { "type": "string", "description": "Minimum supported Torizon OS version." },
            "maxVersion": { "type": "string", "description": "Maximum supported Torizon OS version." },
            "ostreeRef": { "type": "string", "description": "Optional required OSTree reference." }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "description": "App identity metadata and deployment targets.",
      "additionalProperties": false,
      "required": ["meta", "targets"],
      "properties": {
        "meta": {
          "type": "object",
          "description": "App identity and discovery metadata.",
          "additionalProperties": false,
          "required": ["id", "name", "version", "summary", "description"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Stable, globally-unique identifier (reverse-DNS recommended).",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
              "examples": ["io.torizon.apphub.smart-camera"]
            },
            "name": { "type": "string", "minLength": 1, "description": "Human-readable app name." },
            "version": {
              "type": "string",
              "description": "Bundle release version (SemVer recommended).",
              "pattern": "^[0-9]+(\\.[0-9]+){1,2}([\\-+][0-9A-Za-z.-]+)?$",
              "examples": ["1.2.0", "2.0.0-rc.1"]
            },
            "summary": {
              "type": "string",
              "description": "Short markdown summary.",
              "contentMediaType": "text/markdown",
              "minLength": 1,
              "maxLength": 280
            },
            "description": {
              "$ref": "#/$defs/markdownFileRef",
              "description": "Reference to long-form markdown description (default: description.md)."
            },
            "license": {
              "type": "string",
              "description": "SPDX identifier (recommended) or a license expression."
            },
            "tags": {
              "type": "array",
              "description": "Optional discovery tags for filtering and search.",
              "items": { "type": "string", "description": "One tag label." },
              "maxItems": 32
            },
            "links": {
              "type": "object",
              "description": "Optional external links presented in app details.",
              "additionalProperties": false,
              "properties": {
                "homepage": { "type": "string", "format": "uri", "description": "Product homepage URL." },
                "documentation": { "type": "string", "format": "uri", "description": "Documentation URL." },
                "source": { "type": "string", "format": "uri", "description": "Source repository URL." },
                "changelog": { "type": "string", "format": "uri", "description": "Release notes or changelog URL." }
              }
            }
          }
        },
        "targets": {
          "type": "object",
          "description": "Deployment targets packaged with this bundle.",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "os": { "$ref": "#/$defs/targetOs" },
            "application": { "$ref": "#/$defs/targetApplication" },
            "subsystems": {
              "type": "array",
              "description": "Optional subsystem payload targets.",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/targetSubsystem" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "description": "SHA-256 checksum encoded as 64 hexadecimal characters.",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "description": "Reference to a customer-provided file artifact.",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "enum": ["file"], "description": "Literal file reference marker." },
        "path": {
          "type": "string",
          "description": "Filename in the bundle artifact set (no directory segments).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Optional SHA-256 checksum of the referenced file." },
        "sizeBytes": { "type": "integer", "minimum": 0, "description": "Optional file size in bytes." }
      }
    },
    "yamlFileRef": {
      "allOf": [
        { "$ref": "#/$defs/fileRef" },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Must be a YAML filename (no directory segments).",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(ya?ml)$"
            }
          }
        }
      ]
    },
    "composeOverrideRef": {
      "type": "object",
      "description": "Per-machine Docker Compose override file reference.",
      "additionalProperties": false,
      "required": ["path", "machineIds"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Compose override filename (must end with .override.yml).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.override\\.yml$"
        },
        "machineIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Machine IDs targeted by this override.",
          "items": {
            "type": "string",
            "description": "One machine ID value targeted by this compose override.",
            "minLength": 1
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Optional SHA-256 checksum of the referenced override file."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional file size in bytes."
        }
      }
    },
    "applicationComposeRef": {
      "type": "object",
      "description": "Reference to the main docker-compose.yml and optional machine-specific overrides.",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file"],
          "description": "Literal file reference marker."
        },
        "path": {
          "type": "string",
          "description": "Main Docker Compose YAML filename (no directory segments).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(ya?ml)$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Optional SHA-256 checksum of the referenced file."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional file size in bytes."
        },
        "overrides": {
          "type": "array",
          "description": "Optional per-machine compose override files.",
          "items": {
            "$ref": "#/$defs/composeOverrideRef"
          },
          "maxItems": 256
        }
      }
    },
    "configOverrideKey": {
      "type": "object",
      "description": "One configuration override key exposed by App Hub.",
      "additionalProperties": false,
      "required": ["type", "name", "description", "default"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["boolean", "list"],
          "description": "Supported key types for App Hub configuration overrides."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name shown in App Hub configuration UI."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "User-facing explanation shown in App Hub configuration tooltips."
        },
        "default": {
          "description": "Default value for this key (`true|false` for boolean, one item from `valuesList` for list)."
        },
        "valuesList": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Allowed values for `type: list` keys.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One selectable list value."
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "boolean" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean",
                "description": "Default boolean value."
              }
            },
            "not": {
              "required": ["valuesList"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "list" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["valuesList"],
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1,
                "description": "Default list value."
              }
            }
          }
        }
      ]
    },
    "applicationConfigOverrideRef": {
      "type": "object",
      "description": "Reference to the app configuration override file and configurable keys.",
      "additionalProperties": false,
      "required": ["type", "path", "keys"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file"],
          "description": "Literal file reference marker. App Hub currently supports only file-based overrides."
        },
        "path": {
          "type": "string",
          "description": "Configuration filename (no directory segments).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "default": "config.txt"
        },
        "keys": {
          "type": "object",
          "description": "Map of configuration key definitions keyed by stable key IDs.",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]{0,127}$": {
              "$ref": "#/$defs/configOverrideKey"
            }
          }
        }
      }
    },
    "markdownFileRef": {
      "allOf": [
        { "$ref": "#/$defs/fileRef" },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Must be a Markdown filename (no directory segments).",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.md$",
              "default": "description.md"
            }
          }
        }
      ]
    },
    "gitRepo": {
      "type": "object",
      "description": "Git repository source included for OS customization context.",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Git repository URL (https://... or ssh://... etc)."
        },
        "ref": {
          "type": "string",
          "description": "Optional git ref (branch/tag/commit). If absent, default branch is used."
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1,
          "description": "Shallow clone depth. Default is 1 (shallow)."
        },
        "submodules": { "type": "boolean", "default": false, "description": "Whether git submodules should be fetched." }
      }
    },
    "registryCredential": {
      "type": "object",
      "description": "Credential entry used to authenticate against a container registry.",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": {
          "type": "string",
          "description": "Registry hostname (e.g., ghcr.io, registry.example.com).",
          "minLength": 1
        },
        "username": { "type": "string", "description": "Username for basic auth." },
        "password": { "type": "string", "description": "Password for basic auth (prefer secrets reference in future)." },
        "token": { "type": "string", "description": "Token-based auth (alternative to username/password)." },
        "auth": { "type": "string", "description": "Base64-encoded Docker auth field (alternative form)." },
        "note": { "type": "string", "description": "Optional note for maintainers about this credential." }
      },
      "oneOf": [
        { "required": ["username", "password"] },
        { "required": ["token"] },
        { "required": ["auth"] }
      ]
    },
    "targetOs": {
      "type": "object",
      "description": "OS customization deployment target.",
      "additionalProperties": false,
      "required": ["tcbuild", "gitRepos"],
      "properties": {
        "tcbuild": {
          "$ref": "#/$defs/yamlFileRef",
          "description": "Reference to tcbuild.yaml used to build the OS update."
        },
        "gitRepos": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/gitRepo" },
          "description": "Git repositories to shallow-clone for tcbuild.yaml context."
        },
        "notes": { "type": "string", "description": "Optional notes about OS customization behavior." }
      }
    },
    "targetApplication": {
      "type": "object",
      "description": "Application deployment target based on Docker Compose.",
      "additionalProperties": false,
      "required": ["compose"],
      "properties": {
        "compose": {
          "$ref": "#/$defs/applicationComposeRef",
          "description": "Reference to the main docker-compose.yml file and optional per-machine overrides."
        },
        "configOverrides": {
          "$ref": "#/$defs/applicationConfigOverrideRef",
          "description": "Optional App Hub configuration override contract backed by a file referenced from compose `configs`."
        },
        "registryCredentials": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/registryCredential" },
          "description": "Optional registry credentials for TCB to login and pull private images."
        },
        "notes": { "type": "string", "description": "Optional notes about application deployment behavior." }
      }
    },
    "targetSubsystem": {
      "type": "object",
      "description": "Additional subsystem payload target definition.",
      "additionalProperties": false,
      "required": ["name", "subsystemId", "payload"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Human-readable subsystem name." },
        "subsystemId": {
          "type": "string",
          "description": "Mandatory subsystem identifier (mapping handled by app logic later).",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "payload": {
          "$ref": "#/$defs/fileRef",
          "description": "Arbitrary payload file (binary allowed)."
        },
        "kind": { "type": "string", "description": "Optional human hint (mcu-firmware, fpga-bitstream, etc)." },
        "notes": { "type": "string", "description": "Optional notes about subsystem deployment behavior." }
      }
    }
  }
}
