    "ownerSubjectHash",
    "contactEmail",
    "privateNotes",
    "adminAttention",
    "reviewerIdentity",
    "rawSource",
    "storageKey",
    "clientSecret",
    "accessToken",
    "draftPayload"
  ],
  "expected": {
