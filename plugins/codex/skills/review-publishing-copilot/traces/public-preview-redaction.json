    "candidateState": "submitted",
    "candidateSource": "owner-draft"
  },
  "publicAllowlist": [
    "bundleId",
    "name",
    "version",
    "summary",
    "tags",
    "supportedHardwareIds",
    "publicCompatibilityNotes",
    "publicLifecycle",
    "installable",
